// 05_dsa_prime.vclang //
// DSA: Check if a number is prime //

println("--- 05 DSA: Prime Number Checker ---");

string inputStr = input("Enter a positive integer: ");
int n = int(inputStr);

if (n <= 1) {
    println(n, "is NOT a prime number.");
} else {
    int isPrime = 1; // 1 for true, 0 for false
    
    // Check divisors up to n-1 (inefficient but works for demonstration)
    for (int i = 2; i < n; i = i + 1) {
        // We don't have modulo %, so we emulate it: n % i == n - (n/i)*i
        int quotient = n / i;
        int remainder = n - (quotient * i);
        
        if (remainder == 0) {
            isPrime = 0;
            break;
        }
    }
    
    if (isPrime == 1) {
        println(n, "is a prime number!");
    } else {
        println(n, "is NOT a prime number.");
    }
}
