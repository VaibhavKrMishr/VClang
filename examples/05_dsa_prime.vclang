// ============================================================
// 05_dsa_prime.vclang
// DSA: Prime Number Checker and Sieve of Eratosthenes
// ============================================================

println("--- 05 DSA: Prime Numbers ---");

func is_prime(int n) {
    if (n <= 1) { return 0; }
    for (int i = 2; i * i <= n; i = i + 1) {
        if (n % i == 0) {
            return 0;
        }
    }
    return 1;
}

func find_primes_up_to(int limit) {
    int[] primes = [];
    for (int i = 2; i <= limit; i = i + 1) {
        if (is_prime(i) == 1) {
            push(primes, i);
        }
    }
    return primes;
}

println("Is 29 prime?", is_prime(29) == 1);
println("Is 42 prime?", is_prime(42) == 1);

int[] primes_50 = find_primes_up_to(50);
println("Primes up to 50 (" + string(len(primes_50)) + " found):");
println(primes_50);
