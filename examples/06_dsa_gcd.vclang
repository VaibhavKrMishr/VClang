// ============================================================
// 06_dsa_gcd.vclang
// DSA: Euclidean Algorithm for Greatest Common Divisor & LCM
// ============================================================

println("--- 06 DSA: Greatest Common Divisor (GCD) & LCM ---");

func gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

func lcm(int a, int b) {
    return (a * b) / gcd(a, b);
}

int x = 48;
int y = 18;

println("GCD(" + string(x) + ", " + string(y) + ") =", gcd(x, y));
println("LCM(" + string(x) + ", " + string(y) + ") =", lcm(x, y));

println("GCD(1071, 462) =", gcd(1071, 462));
