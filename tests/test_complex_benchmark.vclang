// 6. High-Performance Arena Batch Simulation
// =======================================================
println("\n--- 5. Arena-Backed High-Performance Batch Simulation ---");
Arena batch_pool = new_arena(16384);
print("Batch Arena initialized: "); println(batch_pool);

int total_processed_items = 0;

for (int batch = 1; batch <= 5; batch = batch + 1) {
    // Allocate 100-item vector within the arena
    int[] batch_buffer = new(batch_pool) int[100];
    for (int k = 0; k < 100; k = k + 1) {
        batch_buffer[k] = (batch * 100) + k;
    }
    total_processed_items = total_processed_items + len(batch_buffer);

    // Reset arena memory for next iteration (O(1) wipe)
    reset_arena(batch_pool);
}

print("Total batch elements processed: "); println(total_processed_items);
print("Batch Arena after 5 cycles:     "); println(batch_pool);

