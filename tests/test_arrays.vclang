println("=== 1. Array Literals & Types ===");
int[] nums = [10, 20, 30, 40];
print("nums: "); println(nums);

float[] floats = [1.5, 2.5, 3.5];
print("floats: "); println(floats);

string[] fruits = ["apple", "banana", "cherry"];
print("fruits: "); println(fruits);

println("\n=== 2. Indexing & Modification ===");
print("nums[0]: "); println(nums[0]);
print("nums[2]: "); println(nums[2]);

nums[1] = 99;
print("nums after nums[1] = 99: "); println(nums);

println("\n=== 3. Built-ins: len() and push() ===");
print("len(nums): "); println(len(nums));
print("len(fruits): "); println(len(fruits));

push(nums, 50);
push(nums, 60);
print("nums after push(50), push(60): "); println(nums);
print("new len(nums): "); println(len(nums));

println("\n=== 4. Iteration and Array Sum ===");
int sum = 0;
for (int i = 0; i < len(nums); i = i + 1) {
    sum = sum + nums[i];
}
print("Sum of nums: "); println(sum);

println("\n=== 5. Functions Operating on Arrays ===");
func array_max(int[] a) {
    int max_val = a[0];
    for (int i = 1; i < len(a); i = i + 1) {
        if (a[i] > max_val) {
            max_val = a[i];
        }
    }
    return max_val;
}
print("Max of nums: "); println(array_max(nums));

println("\n=== All Array Tests Passed ===");
