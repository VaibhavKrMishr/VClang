// test_control_flow.vclang //
// Unit tests for control flow

int x = 10;
if (x > 5) {
    // OK
} else {
    println("FAIL: If condition");
}

int count = 0;
while (count < 5) {
    count = count + 1;
}
if (count != 5) { println("FAIL: While loop"); }

int sum = 0;
for (int i = 0; i < 4; i = i + 1) {
    if (i == 1) { continue; }
    if (i == 3) { break; }
    sum = sum + i;
}
// i=0 -> sum=0
// i=1 -> continue
// i=2 -> sum=2
// i=3 -> break
if (sum != 2) { println("FAIL: For loop break/continue"); }

println("Control Flow Tests Passed.");
