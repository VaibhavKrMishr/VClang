#!/bin/bash
# vcc - VClang Compiler Driver

input_file=""
output_file="a.out"

while [[ $# -gt 0 ]]; do
  case $1 in
    -o|--output)
      output_file="$2"
      shift 2
      ;;
    *)
      input_file="$1"
      shift
      ;;
  esac
done

if [[ -z "$input_file" ]]; then
  echo "Usage: vcc <input.cv> [-o output]"
  exit 1
fi

# Ideally, a real compiler would emit binary or C code.
# For now, we create a self-contained executable that wraps the interpreter logic + source.
# A simple approach: create a shell script wrapper.

resolve_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  else
    local dir base
    dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd)"
    base="$(basename "$1")"
    echo "$dir/$base"
  fi
}

# Ensure vclang exists
INTERPRETER_PATH="$(dirname "$(resolve_path "$0")")/vclang"

if [[ ! -f "$INTERPRETER_PATH" ]]; then
    echo "Error: vclang interpreter not found at $INTERPRETER_PATH"
    exit 1
fi

INPUT_REALPATH="$(resolve_path "$input_file")"

cat > "$output_file" <<EOF
#!/bin/bash
"$INTERPRETER_PATH" "$INPUT_REALPATH"
EOF

chmod +x "$output_file"
echo "Compiled $input_file to $output_file"
